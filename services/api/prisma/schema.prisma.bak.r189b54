generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  units             Unit[]
  users             User[]
  roles             Role[]
  settings          BusinessSettings?
  auditLogs         AuditLog[]
  clients           Client[]
  professionals     Professional[]
  serviceCategories ServiceCategory[]
  servicesCatalog   ServiceCatalog[]
  productCategories ProductCategory[]
  products          Product[]
  supplyCategories  SupplyCategory[]
  supplies          SupplyItem[]
  resources         OperationalResource[]
  unitConversions   UnitConversion[]
  appointments      Appointment[]
  availabilities    ProfessionalAvailability[]
  appointmentBlocks AppointmentBlock[]
  attendances       Attendance[]
  sales             Sale[]
  saleItems         SaleItem[]
  payments          Payment[]
  cashRegisters     CashRegister[]
  commissions       Commission[]
  subscription      TenantSubscription?
  entitlements      FeatureEntitlement[]
  healthSnapshots   TenantHealthSnapshot[]
  migrationJobs     MigrationJob[]
  fiscalDocuments   FiscalDocument[]
}

model MigrationJob {
  id                String              @id @default(cuid())
  tenantId          String
  sourceType        MigrationSourceType
  status            MigrationJobStatus  @default(DRAFT)
  sourceReference   String?
  importedRecords   Int                 @default(0)
  reconciledRecords Int                 @default(0)
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  batches MigrationBatch[]

  @@index([tenantId])
  @@index([status])
  @@index([sourceType])
}

model MigrationBatch {
  id              String               @id @default(cuid())
  migrationJobId  String
  batchCode       String
  status          MigrationBatchStatus @default(PENDING)
  importedCount   Int                  @default(0)
  reconciledCount Int                  @default(0)
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  migrationJob MigrationJob @relation(fields: [migrationJobId], references: [id])

  @@index([migrationJobId])
  @@index([status])
  @@index([batchCode])
}

model TenantSubscription {
  id            String        @id @default(cuid())
  tenantId      String        @unique
  planCode      String
  billingStatus BillingStatus @default(TRIAL)
  seats         Int           @default(1)
  startsAt      DateTime?
  renewsAt      DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  addOns TenantAddOn[]

  @@index([billingStatus])
  @@index([planCode])
}

model TenantAddOn {
  id             String        @id @default(cuid())
  subscriptionId String
  code           String
  name           String
  status         BillingStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subscription TenantSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([code])
}

model FeatureEntitlement {
  id          String            @id @default(cuid())
  tenantId    String
  featureCode String
  enabled     Boolean           @default(true)
  source      EntitlementSource @default(PLAN)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, featureCode])
  @@index([featureCode])
}

model TenantHealthSnapshot {
  id                String                  @id @default(cuid())
  tenantId          String
  operationalStatus TenantOperationalStatus @default(HEALTHY)
  financialStatus   TenantFinancialStatus   @default(OK)
  lastMigrationAt   DateTime?
  lastPilotAt       DateTime?
  notes             String?
  createdAt         DateTime                @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([operationalStatus])
  @@index([financialStatus])
}

model Unit {
  id                    String     @id @default(cuid())
  tenantId              String
  name                  String
  code                  String?
  legalName             String?
  tradeName             String?
  cnpj                  String?
  municipalRegistration String?
  stateRegistration     String?
  addressLine1          String?
  addressNumber         String?
  addressComplement     String?
  district              String?
  city                  String?
  state                 String?
  postalCode            String?
  ibgeCityCode          String?
  status                UnitStatus @default(ACTIVE)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  tenant            Tenant                     @relation(fields: [tenantId], references: [id])
  users             User[]
  auditLogs         AuditLog[]
  clients           Client[]
  professionals     Professional[]
  servicesCatalog   ServiceCatalog[]
  products          Product[]
  supplies          SupplyItem[]
  resources         OperationalResource[]
  appointments      Appointment[]
  availabilities    ProfessionalAvailability[]
  appointmentBlocks AppointmentBlock[]
  attendances       Attendance[]
  sales             Sale[]
  saleItems         SaleItem[]
  payments          Payment[]
  cashRegisters     CashRegister[]
  commissions       Commission[]
  fiscalDocuments   FiscalDocument[]

  @@index([tenantId])
  @@index([cnpj])
  @@index([city, state])
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  unitId       String?
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  unit      Unit?      @relation(fields: [unitId], references: [id])
  userRoles UserRole[]
  auditLogs AuditLog[]

  @@index([tenantId])
  @@index([unitId])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model BusinessSettings {
  id                           String                @id @default(cuid())
  tenantId                     String                @unique
  timezone                     String                @default("America/Sao_Paulo")
  currency                     String                @default("BRL")
  cancelPolicyHours            Int                   @default(24)
  lateToleranceMinutes         Int                   @default(10)
  deferredPaymentLabel         String                @default("Pagamento diferido")
  allowDeferredPayment         Boolean               @default(true)
  commissionReleaseMode        CommissionReleaseMode @default(ON_PAYMENT)
  allowCommissionManualRelease Boolean               @default(true)
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String
  unitId       String?
  userId       String?
  entity       String
  entityId     String
  action       String
  traceId      String?
  metadataJson Json?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  unit   Unit?  @relation(fields: [unitId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([userId])
}

model Client {
  id                      String       @id @default(cuid())
  tenantId                String
  unitId                  String?
  name                    String
  socialName              String?
  phone                   String?
  email                   String?
  birthDate               DateTime?
  gender                  String?
  document                String?
  notes                   String?
  preferredProfessionalId String?
  source                  String?
  status                  ClientStatus @default(ACTIVE)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  unit         Unit?         @relation(fields: [unitId], references: [id])
  appointments Appointment[]
  attendances  Attendance[]
  sales        Sale[]

  @@index([tenantId])
  @@index([unitId])
  @@index([phone])
  @@index([email])
}

model Professional {
  id                   String             @id @default(cuid())
  tenantId             String
  unitId               String?
  name                 String
  phone                String?
  email                String?
  roleTitle            String?
  bio                  String?
  status               ProfessionalStatus @default(ACTIVE)
  onlineBookingEnabled Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenant         Tenant                     @relation(fields: [tenantId], references: [id])
  unit           Unit?                      @relation(fields: [unitId], references: [id])
  appointments   Appointment[]
  availabilities ProfessionalAvailability[]
  blocks         AppointmentBlock[]
  attendances    Attendance[]
  sales          Sale[]
  commissions    Commission[]

  @@index([tenantId])
  @@index([unitId])
}

model ServiceCategory {
  id          String        @id @default(cuid())
  tenantId    String
  name        String
  description String?
  sortOrder   Int?
  status      GenericStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  services ServiceCatalog[]

  @@index([tenantId])
}

model ServiceCatalog {
  id                   String        @id @default(cuid())
  tenantId             String
  unitId               String?
  categoryId           String?
  name                 String
  description          String?
  durationMinutes      Int
  price                Decimal       @db.Decimal(10, 2)
  cnaeCode             String?
  serviceListItemCode  String?
  issRate              Decimal?      @db.Decimal(5, 2)
  availableOnline      Boolean       @default(true)
  requiresProfessional Boolean       @default(true)
  status               GenericStatus @default(ACTIVE)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  unit         Unit?            @relation(fields: [unitId], references: [id])
  category     ServiceCategory? @relation(fields: [categoryId], references: [id])
  appointments Appointment[]
  attendances  Attendance[]
  saleItems    SaleItem[]

  @@index([tenantId])
  @@index([unitId])
  @@index([categoryId])
}

model ProductCategory {
  id        String        @id @default(cuid())
  tenantId  String
  name      String
  status    GenericStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@index([tenantId])
}

model Product {
  id            String        @id @default(cuid())
  tenantId      String
  unitId        String?
  categoryId    String?
  name          String
  sku           String?
  description   String?
  cost          Decimal?      @db.Decimal(10, 2)
  salePrice     Decimal       @db.Decimal(10, 2)
  stockQuantity Decimal?      @db.Decimal(10, 3)
  minStock      Decimal?      @db.Decimal(10, 3)
  status        GenericStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  unit      Unit?            @relation(fields: [unitId], references: [id])
  category  ProductCategory? @relation(fields: [categoryId], references: [id])
  saleItems SaleItem[]

  @@index([tenantId])
  @@index([unitId])
  @@index([categoryId])
  @@index([sku])
}

model SupplyCategory {
  id        String        @id @default(cuid())
  tenantId  String
  name      String
  status    GenericStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  supplies SupplyItem[]

  @@index([tenantId])
}

model SupplyItem {
  id              String        @id @default(cuid())
  tenantId        String
  unitId          String?
  categoryId      String?
  name            String
  sku             String?
  description     String?
  baseUnit        String
  operationalUnit String?
  unitCost        Decimal?      @db.Decimal(10, 4)
  stockQuantity   Decimal?      @db.Decimal(12, 4)
  minStock        Decimal?      @db.Decimal(12, 4)
  status          GenericStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  unit        Unit?            @relation(fields: [unitId], references: [id])
  category    SupplyCategory?  @relation(fields: [categoryId], references: [id])
  conversions UnitConversion[]

  @@index([tenantId])
  @@index([unitId])
  @@index([categoryId])
  @@index([sku])
}

model OperationalResource {
  id          String        @id @default(cuid())
  tenantId    String
  unitId      String?
  name        String
  type        String
  description String?
  status      GenericStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  unit         Unit?              @relation(fields: [unitId], references: [id])
  appointments Appointment[]
  blocks       AppointmentBlock[]

  @@index([tenantId])
  @@index([unitId])
}

model UnitConversion {
  id           String        @id @default(cuid())
  tenantId     String
  supplyItemId String
  fromUnit     String
  toUnit       String
  factor       Decimal       @db.Decimal(12, 6)
  roundingRule String?
  status       GenericStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  supplyItem SupplyItem @relation(fields: [supplyItemId], references: [id])

  @@index([tenantId])
  @@index([supplyItemId])
}

model Appointment {
  id                 String             @id @default(cuid())
  tenantId           String
  unitId             String?
  clientId           String
  professionalId     String?
  serviceId          String
  resourceId         String?
  startAt            DateTime
  endAt              DateTime
  status             AppointmentStatus  @default(SCHEDULED)
  source             AppointmentSource  @default(INTERNAL)
  confirmationStatus ConfirmationStatus @default(PENDING)
  isWalkIn           Boolean            @default(false)
  isOverbook         Boolean            @default(false)
  notes              String?
  canceledAt         DateTime?
  canceledReason     String?
  noShowAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  unit         Unit?                @relation(fields: [unitId], references: [id])
  client       Client               @relation(fields: [clientId], references: [id])
  professional Professional?        @relation(fields: [professionalId], references: [id])
  service      ServiceCatalog       @relation(fields: [serviceId], references: [id])
  resource     OperationalResource? @relation(fields: [resourceId], references: [id])
  attendance   Attendance?

  @@index([tenantId])
  @@index([unitId])
  @@index([clientId])
  @@index([professionalId])
  @@index([serviceId])
  @@index([resourceId])
  @@index([startAt])
  @@index([status])
}

model ProfessionalAvailability {
  id             String   @id @default(cuid())
  tenantId       String
  unitId         String?
  professionalId String
  weekday        Int
  startTime      String
  endTime        String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  unit         Unit?        @relation(fields: [unitId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([professionalId])
}

model AppointmentBlock {
  id             String   @id @default(cuid())
  tenantId       String
  unitId         String?
  professionalId String?
  resourceId     String?
  startsAt       DateTime
  endsAt         DateTime
  reason         String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  unit         Unit?                @relation(fields: [unitId], references: [id])
  professional Professional?        @relation(fields: [professionalId], references: [id])
  resource     OperationalResource? @relation(fields: [resourceId], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([professionalId])
  @@index([resourceId])
  @@index([startsAt])
}

model Attendance {
  id             String           @id @default(cuid())
  tenantId       String
  unitId         String?
  appointmentId  String?          @unique
  clientId       String
  professionalId String?
  serviceId      String
  status         AttendanceStatus @default(OPEN)
  startedAt      DateTime?
  finishedAt     DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  unit         Unit?          @relation(fields: [unitId], references: [id])
  appointment  Appointment?   @relation(fields: [appointmentId], references: [id])
  client       Client         @relation(fields: [clientId], references: [id])
  professional Professional?  @relation(fields: [professionalId], references: [id])
  service      ServiceCatalog @relation(fields: [serviceId], references: [id])
  sales        Sale[]

  @@index([tenantId])
  @@index([unitId])
  @@index([appointmentId])
  @@index([clientId])
  @@index([professionalId])
  @@index([serviceId])
  @@index([status])
}

model Sale {
  id             String     @id @default(cuid())
  tenantId       String
  unitId         String?
  attendanceId   String?
  clientId       String?
  professionalId String?
  status         SaleStatus @default(OPEN)
  subtotal       Decimal    @default(0) @db.Decimal(10, 2)
  discountAmount Decimal    @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal    @default(0) @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  unit         Unit?         @relation(fields: [unitId], references: [id])
  attendance   Attendance?   @relation(fields: [attendanceId], references: [id])
  client       Client?       @relation(fields: [clientId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])
  items        SaleItem[]
  payments     Payment[]
  commissions  Commission[]

  @@index([tenantId])
  @@index([unitId])
  @@index([attendanceId])
  @@index([clientId])
  @@index([professionalId])
  @@index([status])
}

model SaleItem {
  id          String       @id @default(cuid())
  tenantId    String
  unitId      String?
  saleId      String
  itemType    SaleItemType
  serviceId   String?
  productId   String?
  description String?
  quantity    Decimal      @default(1) @db.Decimal(10, 3)
  unitPrice   Decimal      @db.Decimal(10, 2)
  totalPrice  Decimal      @db.Decimal(10, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  unit    Unit?           @relation(fields: [unitId], references: [id])
  sale    Sale            @relation(fields: [saleId], references: [id])
  service ServiceCatalog? @relation(fields: [serviceId], references: [id])
  product Product?        @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([saleId])
  @@index([serviceId])
  @@index([productId])
}

model Payment {
  id                   String        @id @default(cuid())
  tenantId             String
  unitId               String?
  saleId               String
  cashRegisterId       String?
  method               PaymentMethod
  status               PaymentStatus @default(PENDING)
  amount               Decimal       @db.Decimal(10, 2)
  isDeferred           Boolean       @default(false)
  deferredDueDate      DateTime?
  deferredSettledAt    DateTime?
  commissionReleasedAt DateTime?
  externalReference    String?
  notes                String?
  paidAt               DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  unit         Unit?         @relation(fields: [unitId], references: [id])
  sale         Sale          @relation(fields: [saleId], references: [id])
  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([saleId])
  @@index([cashRegisterId])
  @@index([status])
  @@index([method])
}

model CashRegister {
  id             String             @id @default(cuid())
  tenantId       String
  unitId         String?
  name           String
  status         CashRegisterStatus @default(CLOSED)
  openedAt       DateTime?
  closedAt       DateTime?
  openingBalance Decimal            @default(0) @db.Decimal(10, 2)
  closingBalance Decimal?           @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  unit     Unit?     @relation(fields: [unitId], references: [id])
  payments Payment[]

  @@index([tenantId])
  @@index([unitId])
  @@index([status])
}

model Commission {
  id               String                @id @default(cuid())
  tenantId         String
  unitId           String?
  saleId           String
  professionalId   String
  baseAmount       Decimal               @db.Decimal(10, 2)
  commissionAmount Decimal               @db.Decimal(10, 2)
  releaseMode      CommissionReleaseMode
  status           CommissionStatus      @default(PENDING)
  releasedManually Boolean               @default(false)
  releasedAt       DateTime?
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  unit         Unit?        @relation(fields: [unitId], references: [id])
  sale         Sale         @relation(fields: [saleId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([saleId])
  @@index([professionalId])
  @@index([status])
}

model FiscalDocument {
  id              String                   @id @default(cuid())
  tenantId        String
  unitId          String?
  sourceType      FiscalDocumentSourceType
  sourceId        String
  documentType    FiscalDocumentType
  status          FiscalDocumentStatus     @default(DRAFT)
  provider        String?
  referenceNumber String?
  accessKey       String?
  errorCode       String?
  errorMessage    String?
  requestedAt     DateTime?
  authorizedAt    DateTime?
  canceledAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  tenant Tenant                @relation(fields: [tenantId], references: [id])
  unit   Unit?                 @relation(fields: [unitId], references: [id])
  events FiscalDocumentEvent[]

  @@index([tenantId])
  @@index([unitId])
  @@index([sourceType, sourceId])
  @@index([documentType])
  @@index([status])
  @@index([referenceNumber])
  @@index([accessKey])
}

model FiscalDocumentEvent {
  id               String                  @id @default(cuid())
  fiscalDocumentId String
  eventType        FiscalDocumentEventType
  message          String?
  payload          Json?
  createdAt        DateTime                @default(now())

  fiscalDocument FiscalDocument @relation(fields: [fiscalDocumentId], references: [id], onDelete: Cascade)

  @@index([fiscalDocumentId])
  @@index([eventType])
  @@index([createdAt])
}

enum TenantStatus {
  ACTIVE
  INACTIVE
}

enum UnitStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

