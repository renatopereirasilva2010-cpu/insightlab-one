import { PrismaClient } from '@prisma/client';

const prisma = new PrismaClient();

async function main() {
  const tenant = await prisma.tenant.findFirst({ where: { slug: 'mix-demo' } });
  if (!tenant) throw new Error('Tenant mix-demo não encontrado');

  const unit = await prisma.unit.findFirst({
    where: { tenantId: tenant.id, code: 'MIX-01' },
  });
  if (!unit) throw new Error('Unit demo não encontrada');

  let serviceCategory = await prisma.serviceCategory.findFirst({
    where: { tenantId: tenant.id, name: 'Cabelo' },
  });

  if (!serviceCategory) {
    serviceCategory = await prisma.serviceCategory.create({
      data: {
        tenantId: tenant.id,
        name: 'Cabelo',
      },
    });
  }

  let productCategory = await prisma.productCategory.findFirst({
    where: { tenantId: tenant.id, name: 'Revenda' },
  });

  if (!productCategory) {
    productCategory = await prisma.productCategory.create({
      data: {
        tenantId: tenant.id,
        name: 'Revenda',
      },
    });
  }

  let supplyCategory = await prisma.supplyCategory.findFirst({
    where: { tenantId: tenant.id, name: 'Colorimetria' },
  });

  if (!supplyCategory) {
    supplyCategory = await prisma.supplyCategory.create({
      data: {
        tenantId: tenant.id,
        name: 'Colorimetria',
      },
    });
  }

  let resource = await prisma.operationalResource.findFirst({
    where: {
      tenantId: tenant.id,
      unitId: unit.id,
      name: 'Estação 1',
    },
  });

  if (!resource) {
    resource = await prisma.operationalResource.create({
      data: {
        tenantId: tenant.id,
        unitId: unit.id,
        name: 'Estação 1',
        type: 'ESTACAO',
      },
    });
  }

  let client = await prisma.client.findFirst({
    where: {
      tenantId: tenant.id,
      email: 'cliente.demo@mix-demo.local',
    },
  });

  if (!client) {
    client = await prisma.client.create({
      data: {
        tenantId: tenant.id,
        unitId: unit.id,
        name: 'Cliente Demo Operacional',
        phone: '41999990001',
        email: 'cliente.demo@mix-demo.local',
        status: 'ACTIVE',
      },
    });
  }

  let professional = await prisma.professional.findFirst({
    where: {
      tenantId: tenant.id,
      email: 'profissional.demo@mix-demo.local',
    },
  });

  if (!professional) {
    professional = await prisma.professional.create({
      data: {
        tenantId: tenant.id,
        unitId: unit.id,
        name: 'Profissional Demo Operacional',
        phone: '41999991112',
        email: 'profissional.demo@mix-demo.local',
        roleTitle: 'Cabeleireiro',
        status: 'ACTIVE',
        onlineBookingEnabled: true,
      },
    });
  }

  let service = await prisma.serviceCatalog.findFirst({
    where: {
      tenantId: tenant.id,
      name: 'Corte Demo Operacional',
    },
  });

  if (!service) {
    service = await prisma.serviceCatalog.create({
      data: {
        tenantId: tenant.id,
        unitId: unit.id,
        categoryId: serviceCategory.id,
        name: 'Corte Demo Operacional',
        durationMinutes: 60,
        price: 89.9,
        availableOnline: true,
        requiresProfessional: true,
        status: 'ACTIVE',
      },
    });
  }

  let availability = await prisma.professionalAvailability.findFirst({
    where: {
      tenantId: tenant.id,
      unitId: unit.id,
      professionalId: professional.id,
      weekday: 1,
      startTime: '09:00',
      endTime: '18:00',
    },
  });

  if (!availability) {
    availability = await prisma.professionalAvailability.create({
      data: {
        tenantId: tenant.id,
        unitId: unit.id,
        professionalId: professional.id,
        weekday: 1,
        startTime: '09:00',
        endTime: '18:00',
        active: true,
      },
    });
  } else if (!availability.active) {
    availability = await prisma.professionalAvailability.update({
      where: { id: availability.id },
      data: { active: true },
    });
  }

  console.log('Seed operacional oficial mínima concluída com sucesso.');
  console.log(
    JSON.stringify(
      {
        tenantId: tenant.id,
        unitId: unit.id,
        clientId: client.id,
        professionalId: professional.id,
        serviceId: service.id,
        resourceId: resource.id,
        availabilityId: availability.id,
      },
      null,
      2,
    ),
  );
}

main()
  .catch((e) => {
    console.error(e);
    process.exit(1);
  })
  .finally(async () => {
    await prisma.$disconnect();
  });