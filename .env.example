NODE_ENV=development

# URLs
ONE_OPS_URL=http://localhost:3000
ONE_BOOKING_URL=http://localhost:3001
ONE_ADMIN_URL=http://localhost:3002
API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://insightlab:insightlab123@localhost:5433/insightlab_one?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Monitoring
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=

# Messaging
EMAIL_PROVIDER=
EMAIL_API_KEY=
# WhatsApp (Meta Cloud API - direto, sem BSP; ver governance/insightlab-one-onda5-backlog-consolidado.md secao 5)
# Vazio = envio pulado e registrado como SKIPPED (não trava o fluxo). Preencher com as
# credenciais de sandbox do Meta for Developers (App > WhatsApp > API Setup) para testar de verdade.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_APPOINTMENT_CONFIRMATION=agendamento_confirmado
SMS_PROVIDER=
SMS_API_KEY=
